rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Анкеты пользователей. Читать может любой вошедший пользователь (нужно
    // для поиска по ID, участников планет и подбора), писать — только свою.
    // Исключение: в чужой анкете разрешено менять только поля-списки контактов
    // и запросов в контакты, чтобы запросы и взаимные контакты работали без
    // серверных функций.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          [
            'contactIds',
            'incomingContactRequestIds',
            'outgoingContactRequestIds'
          ]
        )
      );
    }

    // Отметки на карте планет. Читают все вошедшие, чтобы отметку, оставленную
    // одним участником, видели остальные. Создавать и удалять может только
    // автор; комментарии и лайки разрешено добавлять любому вошедшему.
    // Исключение: если на автора накопилось больше 3 жалоб
    // (`spotReportCounters`), его отметки может убрать любой вошедший — так
    // ложные заметки удаляются у всех.
    match /planets/{planetId}/spots/{spotId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;

      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['comments', 'likedBy']
        )
      );

      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || (
          exists(/databases/$(database)/documents/spotReportCounters/$(resource.data.authorId))
          && get(/databases/$(database)/documents/spotReportCounters/$(resource.data.authorId)).data.count > 3
        )
      );
    }

    // Счётчики жалоб на авторов заметок карты. Документ: число жалоб `count` и
    // список пожаловавшихся `reporters`. Один пользователь может добавить себя
    // только один раз, поэтому счётчик нельзя накрутить в одиночку.
    match /spotReportCounters/{authorId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.count == 1
        && request.resource.data.reporters.size() == 1
        && request.resource.data.reporters[0] == request.auth.uid;

      allow update: if request.auth != null
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.reporters.size() == resource.data.reporters.size() + 1
        && request.auth.uid in request.resource.data.reporters
        && !(request.auth.uid in resource.data.reporters);

      allow delete: if false;
    }

    // События планеты (встречи, поездки, сборы). Читают все вошедшие, чтобы
    // событие, созданное одним участником, видели остальные. Создаёт и удаляет
    // только организатор; заявки на участие (`applicantIds`) может подавать и
    // отменять любой вошедший, а подтверждает участников (`participantIds`)
    // только организатор.
    match /planets/{planetId}/events/{eventId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;

      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['applicantIds']
        )
      );

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Сводка событий всех планет для уведомлений: запрос по всей коллекции
    // `events` (collection group). Чтение разрешено любому вошедшему; запись
    // по-прежнему только через правило `planets/{planetId}/events/{eventId}`.
    match /{path=**}/events/{eventId} {
      allow read: if request.auth != null;
    }

    // Общий чат сообщества планеты. Один чат на планету: читают и пишут все
    // вошедшие, поэтому написанное одним сразу видят остальные. Создать
    // сообщение можно только от своего имени, менять нельзя, удалить — только
    // своё.
    match /planets/{planetId}/chat/{messageId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.senderId == request.auth.uid;
    }

    // Отзывы о сайте и приложении. Читают все вошедшие, писать может каждый
    // от своего имени; изменять чужие отзывы нельзя.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Чаты. Участники диалога видят его и переписываются.
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      allow create: if request.auth != null
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;

        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
